{
  "name": "corkboard",
  "version": "0.1.6",
  "description": "A git-backed kanban and mind-map board that hands cards to Claude Code",
  "author": {
    "name": "agaudreau1997",
    "email": "alexpwnser@live.ca"
  },
  "license": "GPL-3.0-or-later",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "e2e": "electron-vite build && node tests/e2e/smoke.mjs",
    "import-trello": "node scripts/import-trello.mts",
    "install-launcher": "npm run build && bash scripts/install-launcher.sh",
    "install-launcher:appimage": "bash scripts/install-launcher.sh --appimage",
    "icon": "python3 scripts/make-icon.py",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage --publish never",
    "dist:linux:rpm": "electron-vite build && electron-builder --linux rpm --publish never"
  },
  "dependencies": {
    "@xterm/addon-web-links": "^0.12.0",
    "electron-updater": "^6.8.9",
    "node-pty": "1.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.7",
    "zustand": "^5.0.0"
  },
  "desktopName": "corkboard.desktop"
}
