{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../src/shared/*"],
      "yaml": ["./node_modules/yaml"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "vite.config.ts", "capacitor.config.ts", "../src/shared/**/*"]
}
